{
  "name": "@verdant/server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "13.0.0",
    "@fastify/rate-limit": "10.0.0",
    "@fastify/static": "8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@verdant/protocol": "workspace:*",
    "@verdant/sim": "workspace:*",
    "@verdant/world": "workspace:*",
    "fastify": "^5.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
